{%- if section.settings.enable_sticky_bar -%}
  {%- style -%}
    .mobile-sticky-bar {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .mobile-sticky-bar {
        display: flex;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: calc(58px + env(safe-area-inset-bottom, 0px));
        padding-bottom: env(safe-area-inset-bottom, 0px);
        background: {{ section.settings.bg_color }};
        border-top: 1px solid rgba(var(--color-foreground), 0.1);
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
        z-index: 99;
        align-items: center;
        justify-content: space-around;
      }

      body {
        padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)) !important;
      }

      .mobile-sticky-bar__item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: {{ section.settings.text_color }};
        font-size: 1.05rem;
        font-weight: 500;
        flex: 1;
        height: 100%;
        position: relative;
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .mobile-sticky-bar__item svg {
        width: 20px;
        height: 20px;
        margin-bottom: 2px;
        stroke-width: 1.8;
      }

      .mobile-sticky-bar__item.active {
        color: {{ section.settings.active_color }};
        font-weight: 700;
      }

      .mobile-sticky-bar__badge {
        position: absolute;
        top: 6px;
        right: calc(50% - 18px);
        background-color: #b22222;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
      }
    }
  {%- endstyle -%}

  {%- assign is_de = false -%}
  {%- if request.locale.iso_code == 'de' -%}
    {%- assign is_de = true -%}
  {%- endif -%}

  <nav class="mobile-sticky-bar" aria-label="Mobile Navigation">
    <a href="{{ routes.root_url }}" class="mobile-sticky-bar__item{% if request.path == routes.root_url %} active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>{% if is_de %}Start{% else %}Home{% endif %}</span>
    </a>

    <a href="{{ routes.collections_url }}" class="mobile-sticky-bar__item{% if request.path contains '/collections' %} active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>{% if is_de %}Kategorien{% else %}Categories{% endif %}</span>
    </a>

    <button
      type="button"
      class="mobile-sticky-bar__item"
      onclick="
        const searchSummary = document.querySelector('header details-modal summary, header .header__icon--search');
        if (searchSummary) { searchSummary.click(); } else { window.location.href='{{ routes.search_url }}'; }
      "
      aria-label="{% if is_de %}Suche{% else %}Search{% endif %}"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span>{% if is_de %}Suche{% else %}Search{% endif %}</span>
    </button>

    {%- if section.settings.whatsapp_number != blank -%}
      <a
        href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' }}?text={{ section.settings.whatsapp_message | url_encode }}"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-sticky-bar__item"
        style="color: #25D366;"
        aria-label="{% if is_de %}WhatsApp Beratung{% else %}WhatsApp Live Consultation{% endif %}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span style="color: {{ section.settings.text_color }};">{% if is_de %}Beratung{% else %}Chat{% endif %}</span>
      </a>
    {%- endif -%}

    <a
      href="{{ routes.cart_url }}"
      class="mobile-sticky-bar__item"
      id="mobile-sticky-cart-link"
      onclick="
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer) {
          event.preventDefault();
          cartDrawer.open();
        }
      "
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      {%- if cart.item_count > 0 -%}
        <span class="mobile-sticky-bar__badge">{{ cart.item_count }}</span>
      {%- endif -%}
      <span>{% if is_de %}Warenkorb{% else %}Cart{% endif %}</span>
    </a>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Mobile Sticky Bar",
  "tag": "section",
  "class": "section-mobile-sticky-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_bar",
      "label": "Enable Mobile Sticky Navigation",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Icon & Text Color",
      "default": "#103948"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active Tab Color",
      "default": "#673147"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp / Phone Number",
      "default": "4915175316266",
      "info": "Include country code without '+' or spaces, e.g. 4915175316266"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Default WhatsApp Message",
      "default": "Hello Neha Couture, I would like to inquire about an outfit."
    }
  ],
  "presets": [
    {
      "name": "Mobile Sticky Bar"
    }
  ]
}
{% endschema %}
