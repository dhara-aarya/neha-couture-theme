{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .spotlight-slider-wrapper {
    position: relative;
    width: 100%;
  }

  .spotlight-slider-track {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.5rem 0.2rem 1.6rem;
  }

  .spotlight-slider-track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .spotlight-slider-track {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | default: 4 }}, 1fr);
      gap: 2rem;
      overflow-x: visible;
    }
  }

  .spotlight-card {
    flex: 0 0 240px;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #ebd9c8;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  @media screen and (min-width: 990px) {
    .spotlight-card {
      flex: 1 1 0;
    }
  }

  .spotlight-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(103, 49, 71, 0.12);
  }

  .spotlight-card__image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #fdfbf7;
  }

  .spotlight-card__image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .spotlight-card:hover .spotlight-card__image-box img {
    transform: scale(1.08);
  }

  .spotlight-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(103, 49, 71, 0.9);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spotlight-card__body {
    padding: 1.4rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    justify-content: space-between;
  }

  .spotlight-card__title {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.3;
    color: #103948;
    margin: 0 0 0.4rem;
  }

  .spotlight-card__subtitle {
    font-size: 1.2rem;
    color: #55666f;
    margin: 0 0 1rem;
    line-height: 1.35;
  }

  .spotlight-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #673147;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .spotlight-card:hover .spotlight-card__cta {
    color: #923e61;
    transform: translateX(3px);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- assign is_de = false -%}
    {%- if request.locale.iso_code == 'de' -%}
      {%- assign is_de = true -%}
    {%- endif -%}

    {%- assign spot_title = section.settings.title -%}
    {%- assign spot_subtitle = section.settings.subtitle -%}
    {%- if is_de -%}
      {%- if spot_title contains "Women's Couture" or spot_title contains "Outfits" -%}
        {%- assign spot_title = 'Damen Couture & Festliche Outfits' -%}
        {%- assign spot_subtitle = 'Königliche Shararas, echte Seidensaris, handbestickte Damenanzüge & Cholis' -%}
      {%- elsif spot_title contains "Blouses" or spot_title contains "Petticoat" -%}
        {%- assign spot_title = 'Blusen, Unterröcke & Schuhe' -%}
        {%- assign spot_subtitle = 'Vervollständigen Sie Ihre Garderobe mit Designer-Blusen, Shapewear & Punjabi Juttis' -%}
      {%- elsif spot_title contains "Men" or spot_title contains "Kids" -%}
        {%- assign spot_title = 'Herren & Kinder Festtagskollektionen' -%}
        {%- assign spot_subtitle = 'Maßgeschneiderte Nehru-Westen, reine Seidenkurtas & königliche Mode für Jungen & Mädchen' -%}
      {%- endif -%}
    {%- endif -%}

    {%- if spot_title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin center">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ spot_title }}
        </h2>
        {%- if spot_subtitle != blank -%}
          <p class="collection__description">
            {{ spot_subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="spotlight-slider-wrapper">
      <div class="spotlight-slider-track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_title = block.settings.title
            assign card_subtitle = block.settings.subtitle
            assign card_badge = block.settings.badge

            if is_de
              case card_title
                when 'Shararas & Suits'
                  assign card_title = 'Shararas & Damenanzüge'
                  assign card_subtitle = 'Handbestickte Festanzüge mit Dupatta'
                when 'Pure Silk Sarees'
                  assign card_title = 'Echte Seidensaris'
                  assign card_subtitle = 'Banarasi & Kanjivaram Webkunst'
                when 'Designer Blouses'
                  assign card_title = 'Designer-Blusen'
                  assign card_subtitle = 'Genähte Cholis mit 4 cm Nahtzugabe'
                when 'Underskirts & Petticoats'
                  assign card_title = 'Unterröcke & Shapewear'
                  assign card_subtitle = 'Bequeme Passform für perfekte Drapierung'
                when 'Punjabi Juttis'
                  assign card_title = 'Punjabi Juttis'
                  assign card_subtitle = 'Handbestickte Echtlederschuhe'
                when "Men's Kurtas & Jackets"
                  assign card_title = 'Herren-Kurtas & Westen'
                  assign card_subtitle = 'Traditionelle Schnitte aus Baumwolle & Seide'
                when 'Girls Lehengas & Sets'
                  assign card_title = 'Mädchen-Lehengas'
                  assign card_subtitle = 'Bequeme Festmode mit weichem Innenfutter'
                when 'Boys Sherwanis & Kurtas'
                  assign card_title = 'Jungen-Kurtas & Sets'
                  assign card_subtitle = 'Festliche Ensembles für Jungen'
              endcase

              case card_badge
                when 'Royal Festive'
                  assign card_badge = 'Königlich'
                when 'Heritage Weaves'
                  assign card_badge = 'Tradition'
                when 'Tailored Margins'
                  assign card_badge = 'Mit Nahtzugabe'
                when 'Shape & Drape'
                  assign card_badge = 'Shapewear'
                when 'Artisan Leather'
                  assign card_badge = 'Echtes Leder'
                when 'Gentlemen'
                  assign card_badge = 'Herren'
                when 'Princess Flare'
                  assign card_badge = 'Prinzessin'
                when 'Little Royals'
                  assign card_badge = 'Festlich'
              endcase
            endif
          -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="spotlight-card"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <div class="spotlight-card__image-box">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: card_title
                }}
              {%- elsif block.settings.asset_image != blank -%}
                <img
                  src="{{ block.settings.asset_image | asset_url }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="450"
                  height="600"
                >
              {%- else -%}
                <div style="width:100%;height:100%;background:#f0e8df;"></div>
              {%- endif -%}

              {%- if card_badge != blank -%}
                <span class="spotlight-card__badge">{{ card_badge }}</span>
              {%- endif -%}
            </div>

            <div class="spotlight-card__body">
              <div>
                <h3 class="spotlight-card__title">{{ card_title }}</h3>
                {%- if card_subtitle != blank -%}
                  <p class="spotlight-card__subtitle">{{ card_subtitle }}</p>
                {%- endif -%}
              </div>
              <span class="spotlight-card__cta">
                {% if is_de %}Kollektion ansehen &rarr;{% else %}View Collection &rarr;{% endif %}
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category Spotlight Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Category Spotlight"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Explore our curated collections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Asset Image Filename (Optional)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Explore handcrafted pieces"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Spotlight Slider",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
