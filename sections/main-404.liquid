<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
</style>

{%- if request.path == '/llms.txt' or request.path == '/assets/llms.txt' or request.path contains 'llms.txt' -%}
  <script>
    window.location.replace("{{ shop.url }}/pages/llms-txt");
  </script>
  <div class="page-width page-margin" style="text-align: left; max-width: 850px; margin: 3rem auto; font-family: monospace;">
    <p style="margin-bottom: 1rem;">Redirecting to <a href="{{ shop.url }}/pages/llms-txt">{{ shop.url }}/pages/llms-txt</a>...</p>
    <div style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 20px; white-space: pre-wrap; font-size: 13px; line-height: 1.6; color: #212529;">{% render 'llms-txt-content' %}</div>
  </div>
{%- elsif request.path == '/llms-full.txt' or request.path == '/assets/llms-full.txt' or request.path contains 'llms-full.txt' -%}
  <script>
    window.location.replace("{{ shop.url }}/pages/llms-full");
  </script>
  <div class="page-width page-margin" style="text-align: left; max-width: 850px; margin: 3rem auto; font-family: monospace;">
    <p style="margin-bottom: 1rem;">Redirecting to <a href="{{ shop.url }}/pages/llms-full">{{ shop.url }}/pages/llms-full</a>...</p>
  </div>
{%- else -%}
<div class="template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    {{ 'general.continue_shopping' | t }}
  </a>
</div>
{%- endif -%}
