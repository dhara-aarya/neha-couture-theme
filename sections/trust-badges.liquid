{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .trust-badges-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 990px) {
    .trust-badges-grid {
      grid-template-columns: repeat({{ section.blocks.size | default: 4 }}, 1fr);
      gap: 2.4rem;
    }
  }

  .trust-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.6rem;
    background: rgba(var(--color-foreground), 0.03);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .trust-badge-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    border-color: rgba(var(--color-foreground), 0.16);
  }

  .trust-badge-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
    color: #673147;
  }

  .trust-badge-icon svg {
    width: 36px;
    height: 36px;
    stroke-width: 1.6;
  }

  .trust-badge-icon img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .trust-badge-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: rgb(var(--color-foreground));
    line-height: 1.3;
  }

  .trust-badge-text {
    font-size: 1.25rem;
    color: rgba(var(--color-foreground), 0.75);
    margin: 0;
    line-height: 1.4;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- assign is_de = false -%}
    {%- if request.locale.iso_code == 'de' -%}
      {%- assign is_de = true -%}
    {%- endif -%}

    {%- assign tb_title = section.settings.title -%}
    {%- assign tb_subtitle = section.settings.subtitle -%}
    {%- if is_de -%}
      {%- assign tb_title = 'Warum Neha Couture wählen' -%}
      {%- assign tb_subtitle = 'Authentische indische Mode direkt zu Ihnen nach Europa gebracht' -%}
    {%- endif -%}

    {%- if tb_title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin center">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ tb_title }}
        </h2>
        {%- if tb_subtitle != blank -%}
          <p class="collection__description">
            {{ tb_subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="trust-badges-grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b_title = block.settings.title
          assign b_desc = block.settings.description

          if is_de
            case block.settings.icon_type
              when 'shipping'
                assign b_title = 'Schneller DHL-Versand (1–3 Tage)'
                assign b_desc = 'Verfolgter Expressversand direkt aus unserem Berliner Logistikzentrum. Keine Zollgebühren innerhalb der EU.'
              when 'craft'
                assign b_title = 'Echte indische Handwerkskunst'
                assign b_desc = 'Reine Seide, meisterhafte Zari-Stickereien und traditionelle Webkunst von Kunsthandwerkern aus ganz Indien.'
              when 'location'
                assign b_title = 'Showroom in Berlin (The Playce)'
                assign b_desc = 'Besuchen Sie uns am Potsdamer Platz (Shop 55, Ebene -1), um Stoffe zu fühlen, Farben zu sehen und Outfits anzuprobieren.'
              when 'security'
                assign b_title = 'Sicher & Zuverlässig einkaufen'
                assign b_desc = '100 % vertrauenswürdige Bezahlung, 14 Tage Rückgaberecht und persönlicher Kundenservice per WhatsApp.'
            endcase
          endif
        -%}
        <div class="trust-badge-item" role="listitem" {{ block.shopify_attributes }}>
          <div class="trust-badge-icon">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {%- case block.settings.icon_type -%}
                {%- when 'shipping' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {%- when 'craft' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                {%- when 'location' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                {%- when 'security' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 14 14"></polyline>
                  </svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          {%- if b_title != blank -%}
            <h3 class="trust-badge-title">{{ b_title }}</h3>
          {%- endif -%}
          {%- if b_desc != blank -%}
            <p class="trust-badge-text">{{ b_desc }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Shop With Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Why Choose Neha Couture"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Experience authentic Indian heritage tailored for you in Germany"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Trust Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Built-in Icon",
          "options": [
            { "value": "shipping", "label": "Fast Delivery" },
            { "value": "craft", "label": "Handcrafted Luxury" },
            { "value": "location", "label": "Berlin Store / Video Consultation" },
            { "value": "security", "label": "Secure Checkout" }
          ],
          "default": "shipping"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Shipping in Germany"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "1-3 days dispatch. Free shipping over 40€."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Shop With Us",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_type": "shipping",
            "title": "Fast 1-3 Day Delivery",
            "description": "Shipped from Germany. Free delivery on orders over €40."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "craft",
            "title": "Authentic Handcrafted Couture",
            "description": "Pure silks, intricate zari & hand embroidery directly from artisan weavers."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "location",
            "title": "Berlin Showroom & Video Calls",
            "description": "Try outfits in person in Berlin or book a 1-on-1 live video consultation."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "security",
            "title": "Secure Card & Online Checkout",
            "description": "Shop safely with Visa, Mastercard, Maestro, and SSL encrypted checkout."
          }
        }
      ]
    }
  ]
}
{% endschema %}
