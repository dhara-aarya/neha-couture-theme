{%- if collection.handle == 'fresh-flowers' or collection.handle contains 'flower' -%}
  {%- assign is_de = false -%}
  {%- if request.locale.iso_code == 'de' -%}
    {%- assign is_de = true -%}
  {%- endif -%}

  {%- style -%}
    .flowers-subcats-section {
      padding: 2.4rem 0 3.2rem;
      background: #faf7f2;
      border-bottom: 1px solid #ebd9c8;
    }

    .flowers-subcats-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .flowers-subcats-title {
      font-family: var(--font-heading-family);
      font-size: 2.4rem;
      font-weight: 700;
      color: #103948;
      margin: 0 0 0.5rem;
    }

    .flowers-subcats-subtitle {
      font-size: 1.4rem;
      color: #55666f;
      margin: 0;
    }

    .flowers-subcats-track {
      display: flex;
      gap: 1.6rem;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 0.8rem 1rem 1.6rem;
      justify-content: flex-start;
    }

    .flowers-subcats-track::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 990px) {
      .flowers-subcats-track {
        justify-content: center;
        flex-wrap: wrap;
        gap: 2rem;
      }
    }

    .flowers-subcat-card {
      flex: 0 0 105px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      cursor: pointer;
      text-decoration: none;
      background: transparent;
      border: none;
      padding: 0;
      transition: transform 0.25s ease;
      outline: none;
    }

    @media screen and (min-width: 750px) {
      .flowers-subcat-card {
        flex: 0 0 120px;
      }
    }

    .flowers-subcat-card:hover {
      transform: translateY(-3px);
    }

    .flowers-subcat-circle {
      position: relative;
      width: 86px;
      height: 86px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid #ffffff;
      box-shadow: 0 4px 12px rgba(103, 49, 71, 0.12);
      transition: all 0.25s ease;
      background: #ffffff;
    }

    @media screen and (min-width: 750px) {
      .flowers-subcat-circle {
        width: 100px;
        height: 100px;
      }
    }

    .flowers-subcat-card.is-active .flowers-subcat-circle,
    .flowers-subcat-card:hover .flowers-subcat-circle {
      border-color: #673147;
      box-shadow: 0 6px 18px rgba(103, 49, 71, 0.3);
      transform: scale(1.05);
    }

    .flowers-subcat-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.35s ease;
    }

    .flowers-subcat-card:hover .flowers-subcat-circle img {
      transform: scale(1.08);
    }

    .flowers-subcat-name {
      margin-top: 0.8rem;
      font-size: 1.25rem;
      font-weight: 600;
      color: #103948;
      line-height: 1.25;
      max-width: 115px;
      transition: color 0.2s ease;
    }

    .flowers-subcat-card.is-active .flowers-subcat-name,
    .flowers-subcat-card:hover .flowers-subcat-name {
      color: #673147;
      font-weight: 700;
    }

    .flowers-subcat-count {
      font-size: 1.15rem;
      color: #7b8b93;
      margin-top: 0.2rem;
      font-weight: 500;
    }

    .flowers-subcat-card.is-active .flowers-subcat-count {
      color: #673147;
      font-weight: 600;
    }

    .flowers-filter-status-bar {
      display: none;
      align-items: center;
      justify-content: space-between;
      background: #ffffff;
      border: 1px solid #ebd9c8;
      border-radius: 30px;
      padding: 0.8rem 1.8rem;
      margin: 1.4rem auto 0;
      max-width: 540px;
      font-size: 1.35rem;
      color: #103948;
      box-shadow: 0 4px 14px rgba(103, 49, 71, 0.08);
    }

    .flowers-reset-btn {
      background: #673147;
      color: #ffffff;
      border: none;
      border-radius: 20px;
      padding: 0.5rem 1.4rem;
      font-size: 1.25rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .flowers-reset-btn:hover {
      background: #923e61;
    }
  {%- endstyle -%}

  <div class="flowers-subcats-section">
    <div class="page-width">
      <div class="flowers-subcats-header">
        <h2 class="flowers-subcats-title">
          {%- if is_de -%}
            Frische Festtagsblumen nach Kategorie shoppen
          {%- else -%}
            Shop Fresh & Festive Flowers By Category
          {%- endif -%}
        </h2>
        <p class="flowers-subcats-subtitle">
          {%- if is_de -%}
            Duftender Jasmin, Rosenblätter, Ringelblumen, traditionelle Girlanden und Pooja-Behänge
          {%- else -%}
            Fragrant jasmine, fresh rose petals, marigolds, festive garlands, and pooja floral strings
          {%- endif -%}
        </p>
      </div>

      <div class="flowers-subcats-track" role="list" id="FlowersSubcatTrack">
        <!-- 1. All Flowers -->
        <button type="button" class="flowers-subcat-card is-active" data-style="all" role="listitem">
          <div class="flowers-subcat-circle">
            <img src="{{ 'subcat-flowers-all.jpg' | asset_url }}" alt="All Flowers" width="100" height="100" loading="lazy">
          </div>
          <span class="flowers-subcat-name">{% if is_de %}Alle Blumen{% else %}All Flowers{% endif %}</span>
          <span class="flowers-subcat-count">134 Items</span>
        </button>

        <!-- 2. Jasmine & Malli -->
        <button type="button" class="flowers-subcat-card" data-style="jasmine" role="listitem">
          <div class="flowers-subcat-circle">
            <img src="{{ 'subcat-flowers-jasmine.jpg' | asset_url }}" alt="Jasmine and Madurai Malli" width="100" height="100" loading="lazy">
          </div>
          <span class="flowers-subcat-name">{% if is_de %}Jasmin & Malli{% else %}Jasmine & Malli{% endif %}</span>
          <span class="flowers-subcat-count">9 Styles</span>
        </button>

        <!-- 3. Rose Petals -->
        <button type="button" class="flowers-subcat-card" data-style="rose" role="listitem">
          <div class="flowers-subcat-circle">
            <img src="{{ 'subcat-flowers-rose.jpg' | asset_url }}" alt="Fresh Rose Petals" width="100" height="100" loading="lazy">
          </div>
          <span class="flowers-subcat-name">{% if is_de %}Rosenblätter{% else %}Rose Petals{% endif %}</span>
          <span class="flowers-subcat-count">35 Styles</span>
        </button>

        <!-- 4. Marigold Petals -->
        <button type="button" class="flowers-subcat-card" data-style="marigold" role="listitem">
          <div class="flowers-subcat-circle">
            <img src="{{ 'subcat-flowers-marigold.jpg' | asset_url }}" alt="Marigold Petals" width="100" height="100" loading="lazy">
          </div>
          <span class="flowers-subcat-name">{% if is_de %}Ringelblumen{% else %}Marigold Petals{% endif %}</span>
          <span class="flowers-subcat-count">18 Styles</span>
        </button>

        <!-- 5. Floral Strings & Malai -->
        <button type="button" class="flowers-subcat-card" data-style="strings" role="listitem">
          <div class="flowers-subcat-circle">
            <img src="{{ 'subcat-flowers-strings.jpg' | asset_url }}" alt="Floral Strings and Malai" width="100" height="100" loading="lazy">
          </div>
          <span class="flowers-subcat-name">{% if is_de %}Blumenschnüre & Malai{% else %}Strings & Malai{% endif %}</span>
          <span class="flowers-subcat-count">45 Styles</span>
        </button>

        <!-- 6. Festive & Temple Garlands -->
        <button type="button" class="flowers-subcat-card" data-style="garlands" role="listitem">
          <div class="flowers-subcat-circle">
            <img src="{{ 'subcat-flowers-garlands.jpg' | asset_url }}" alt="Festive and Wedding Garlands" width="100" height="100" loading="lazy">
          </div>
          <span class="flowers-subcat-name">{% if is_de %}Festtags-Girlanden{% else %}Temple Garlands{% endif %}</span>
          <span class="flowers-subcat-count">66 Styles</span>
        </button>
      </div>

      <!-- Active Filter Feedback Bar -->
      <div id="FlowersFilterStatusBar" class="flowers-filter-status-bar">
        <span id="FlowersFilterStatusText">Showing: <strong>All Flowers</strong></span>
        <button type="button" id="FlowersFilterResetBtn" class="flowers-reset-btn">
          {%- if is_de -%}✕ Filter zurücksetzen{%- else -%}✕ Clear Filter{%- endif -%}
        </button>
      </div>
    </div>
  </div>

  <script>
    (function() {
      let cachedFlowers = null;
      let originalGridHTML = null;
      let isOriginalCaptured = false;

      fetch("{{ 'flowers-products.json' | asset_url }}")
        .then(r => r.json())
        .then(data => {
          cachedFlowers = data;
          checkInitialURL();
        })
        .catch(err => console.error('Error preloading flowers catalog:', err));

      function getTargetGrid() {
        const el = document.getElementById('product-grid');
        if (el && el.tagName === 'UL') return el;
        return document.querySelector('ul#product-grid') 
          || document.querySelector('#product-grid ul.product-grid')
          || document.querySelector('#ProductGridContainer ul.product-grid')
          || document.querySelector('ul.product-grid')
          || document.getElementById('product-grid');
      }

      function captureOriginal() {
        if (isOriginalCaptured) return;
        const grid = getTargetGrid();
        if (grid && grid.innerHTML.trim().length > 0) {
          originalGridHTML = grid.innerHTML;
          isOriginalCaptured = true;
        }
      }

      function updateCountDisplays(cnt) {
        const countEls = document.querySelectorAll('#ProductCount, #ProductCountDesktop, .product-count__text span');
        countEls.forEach(el => {
          el.textContent = `${cnt} products`;
        });
      }

      function renderFilteredProducts(items, styleName) {
        const grid = getTargetGrid();
        if (!grid) return;

        captureOriginal();

        const pagination = document.querySelector('.pagination-wrapper, .pagination');
        if (pagination) pagination.style.display = 'none';

        const emptyNotice = document.querySelector('.collection--empty');
        if (emptyNotice) emptyNotice.style.display = 'none';

        updateCountDisplays(items.length);

        const statusBar = document.getElementById('FlowersFilterStatusBar');
        const statusText = document.getElementById('FlowersFilterStatusText');
        if (statusBar && statusText) {
          statusBar.style.display = 'flex';
          statusText.innerHTML = `Filtered: <strong>${styleName}</strong> (${items.length} styles found)`;
        }

        grid.innerHTML = items.map(p => {
          const img = p.image || '';
          const price = p.price || '0.00';
          return `
            <li class="grid__item">
              <div class="card-wrapper product-card-wrapper underline-links-hover">
                <div class="card card--standard card--media" style="--ratio-percent: 133.33%;">
                  <div class="card__inner color-background-2 gradient ratio" style="--ratio-percent: 133.33%;">
                    <div class="card__media">
                      <div class="media media--transparent media--hover-effect" style="aspect-ratio: 3/4;">
                        <img src="${img}" alt="${p.title}" loading="lazy" class="motion-reduce" style="width:100%;height:100%;object-fit:cover;">
                      </div>
                    </div>
                  </div>
                  <div class="card__content" style="padding-top: 1.2rem; text-align: center;">
                    <div class="card__information">
                      <h3 class="card__heading h5" style="font-size: 1.45rem; line-height: 1.35; margin-bottom: 0.6rem;">
                        <a href="/products/${p.handle}" class="full-unstyled-link" style="color: #103948; text-decoration: none; font-weight: 600;">
                          ${p.title}
                        </a>
                      </h3>
                      <div class="card-information">
                        <span class="price-item price-item--regular" style="font-weight: 700; color: #673147; font-size: 1.5rem;">
                          €${parseFloat(price).toFixed(2)}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          `;
        }).join('');

        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function restoreOriginal() {
        const grid = getTargetGrid();
        if (grid && originalGridHTML) {
          grid.innerHTML = originalGridHTML;
        }
        const pagination = document.querySelector('.pagination-wrapper, .pagination');
        if (pagination) pagination.style.display = '';

        updateCountDisplays(134);

        const statusBar = document.getElementById('FlowersFilterStatusBar');
        if (statusBar) statusBar.style.display = 'none';

        const cards = document.querySelectorAll('.flowers-subcat-card');
        cards.forEach(c => {
          if (c.getAttribute('data-style') === 'all') c.classList.add('is-active');
          else c.classList.remove('is-active');
        });

        if (history.replaceState) {
          history.replaceState(null, '', window.location.pathname);
        }
      }

      function handleFilterClick(styleKey, styleName) {
        const cards = document.querySelectorAll('.flowers-subcat-card');
        cards.forEach(c => {
          if (c.getAttribute('data-style') === styleKey) c.classList.add('is-active');
          else c.classList.remove('is-active');
        });

        if (history.replaceState) {
          const newUrl = styleKey === 'all' 
            ? window.location.pathname 
            : window.location.pathname + '?style=' + encodeURIComponent(styleKey);
          history.replaceState(null, '', newUrl);
        }

        if (styleKey === 'all') {
          restoreOriginal();
          return;
        }

        if (!cachedFlowers) {
          fetch("{{ 'flowers-products.json' | asset_url }}")
            .then(r => r.json())
            .then(data => {
              cachedFlowers = data;
              const matches = cachedFlowers.filter(b => b.styles && b.styles.includes(styleKey));
              renderFilteredProducts(matches, styleName);
            });
        } else {
          const matches = cachedFlowers.filter(b => b.styles && b.styles.includes(styleKey));
          renderFilteredProducts(matches, styleName);
        }
      }

      function checkInitialURL() {
        const urlParams = new URLSearchParams(window.location.search);
        const style = urlParams.get('style') || urlParams.get('type') || window.location.hash.replace('#', '');
        if (style && style !== 'all') {
          const targetCard = document.querySelector(`.flowers-subcat-card[data-style="${style}"]`);
          if (targetCard) {
            const name = targetCard.querySelector('.flowers-subcat-name').textContent.trim();
            handleFilterClick(style, name);
          }
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        const track = document.getElementById('FlowersSubcatTrack');
        const resetBtn = document.getElementById('FlowersFilterResetBtn');
        if (!track) return;

        const cards = track.querySelectorAll('.flowers-subcat-card');
        cards.forEach(card => {
          card.addEventListener('click', function(e) {
            e.preventDefault();
            const style = this.getAttribute('data-style');
            const name = this.querySelector('.flowers-subcat-name').textContent.trim();
            handleFilterClick(style, name);
          });
        });

        if (resetBtn) {
          resetBtn.addEventListener('click', function() {
            restoreOriginal();
          });
        }

        setTimeout(captureOriginal, 1000);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Flowers Subcategories",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Flowers Subcategories"
    }
  ]
}
{% endschema %}
