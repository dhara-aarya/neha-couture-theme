{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .brand-entity-card {
    background: #ffffff;
    border: 1px solid #ebd9c8;
    border-radius: 16px;
    padding: 3.2rem 2.4rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  @media screen and (min-width: 750px) {
    .brand-entity-card {
      padding: 4.8rem 5.6rem;
    }
  }

  .brand-entity-badge {
    display: inline-block;
    color: #673147;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .brand-entity-heading {
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: 700;
    color: #103948;
    line-height: 1.25;
    margin: 0 0 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .brand-entity-heading {
      font-size: 3rem;
    }
  }

  .brand-entity-text {
    font-size: 1.5rem;
    line-height: 1.7;
    color: #3b4e57;
    margin: 0 0 2rem;
  }

  .brand-entity-text strong {
    color: #103948;
  }

  .brand-entity-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    border-top: 1px solid #ebd9c8;
    padding-top: 2rem;
  }

  @media screen and (min-width: 750px) {
    .brand-entity-highlights {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .brand-entity-highlight {
    font-size: 1.35rem;
    line-height: 1.5;
    color: #4a5b63;
  }

  .brand-entity-highlight strong {
    display: block;
    color: #673147;
    font-size: 1.45rem;
    margin-bottom: 0.3rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- assign is_de = false -%}
    {%- if request.locale.iso_code == 'de' -%}
      {%- assign is_de = true -%}
    {%- endif -%}

    <div class="brand-entity-card">
      <span class="brand-entity-badge">{% if is_de %}Authentische indische Couture{% else %}{{ section.settings.subheading }}{% endif %}</span>
      <h2 class="brand-entity-heading">{% if is_de %}Über Neha Couture — Indische Fest- & Brautmode in Deutschland{% else %}{{ section.settings.heading }}{% endif %}</h2>
      <div class="brand-entity-text">
        {%- if is_de -%}
          <p><strong>Neha Couture</strong> ist Berlins führende Boutique für authentische indische Festtags- und Brautmode, handgefertigte Designer-Lehengas, echte Seidensaris, Shararas, Kurtis und traditionellen indischen Schmuck für Kundinnen und Kunden in ganz Europa.</p>
          <p>Wir verbinden die kunstvolle Handarbeit indischer Webmeister und Handwerker mit der südasiatischen Diaspora und Modeliebhabern in ganz Europa. Mit schnellem 1–3 Tage Expressversand per DHL in ganz Deutschland, europaweiter Lieferung, persönlicher Video-Stylingberatung und unserem Showroom im The Playce am Potsdamer Platz in Berlin bringt Neha Couture zeitlose indische Eleganz direkt zu Ihnen.</p>
        {%- else -%}
          <p><strong>Neha Couture</strong> is a premium South Asian and Indian bridal and ethnic wear destination based in Berlin, Germany, specializing in handcrafted lehengas, pure silk sarees, shararas, kurtis, and traditional Indian jewellery for European customers.</p>
          <p>We connect the authentic craftsmanship of Indian master weavers and artisans with the South Asian diaspora and fashion lovers across Europe. With 1–3 day express shipping throughout Germany, EU-wide delivery, live video styling consultations, and visiting our showroom at The Playce in Berlin, Neha Couture delivers timeless elegance for weddings, festive celebrations, and everyday grace.</p>
        {%- endif -%}
      </div>

      <div class="brand-entity-highlights">
        {%- if is_de -%}
          <div class="brand-entity-highlight">
            <strong>📍 Showroom & Rücksendungen</strong>
            <span><strong>Boutique (Einkauf, Anprobe & persönliche Rückgabe):</strong> The Playce (Potsdamer Platz), Shop 55, Ebene -1, Alte Potsdamer Str. 7, 10785 Berlin (Mo–Sa 10:00–20:00 Uhr).<br><strong>Retourenlager (Postrücksendungen):</strong> Neha Aggarwal, Dolgenseestr. 9A, 10319 Berlin (Paketrücksendungen bitte ausschließlich hierher senden).</span>
          </div>
          <div class="brand-entity-highlight">
            <strong>🥻 Echte Handwerkskunst</strong>
            <span>Reine Seide, meisterhafte Zardozi-Handstickerei und festliche Brautkollektionen direkt von Kunsthandwerkern aus Indien.</span>
          </div>
          <div class="brand-entity-highlight">
            <strong>🎥 Live Video-Styling (10–20 Uhr)</strong>
            <span>Begutachten Sie Outfits bei natürlichem Licht in individuellen 1-zu-1 Video-Walkthroughs mit unserem Berliner Team (Mo–Sa).</span>
          </div>
        {%- else -%}
          <div class="brand-entity-highlight">
            <strong>📍 Store & Returns Addresses</strong>
            <span><strong>Retail Boutique (Shopping & In-Person Returns):</strong> Located exclusively at The Playce (Potsdamer Platz), Shop No. 55, Level -1, Alte Potsdamer Str. 7, 10785 Berlin (open Mon–Sat 10am–8pm; in-person returns & exchanges accepted here by hand).<br><strong>Postal Returns Center (Mailed Returns):</strong> Neha Aggarwal, Dolgenseestr. 9A, 10319 Berlin, Germany (all mailed return parcels must be shipped here; package shipping to Potsdamer Platz store is currently not possible).</span>
          </div>
          <div class="brand-entity-highlight">
            <strong>🥻 Authentic Artisan Heritage</strong>
            <span>Pure silk weaves, intricate hand zardozi work, and heirloom bridal collections curated directly from India.</span>
          </div>
          <div class="brand-entity-highlight">
            <strong>🎥 Live Virtual Styling (10am–8pm)</strong>
            <span>Experience outfits in natural light on 1-on-1 video call consultations with our Berlin stylists (Mon–Sat).</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Entity (AI SEO)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "About Neha Couture — South Asian & Indian Ethnic Wear in Germany"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Authoritative Brand Positioning"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Brand Entity (AI SEO)"
    }
  ]
}
{% endschema %}
