{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .jewellery-slider-wrapper {
    position: relative;
    width: 100%;
  }

  .jewellery-slider-track {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.5rem 0.2rem 1.6rem;
  }

  .jewellery-slider-track::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .jewellery-slider-track {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | default: 5 }}, 1fr);
      gap: 2rem;
      overflow-x: visible;
    }
  }

  .jewellery-card {
    flex: 0 0 240px;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #ebd9c8;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  @media screen and (min-width: 990px) {
    .jewellery-card {
      flex: 1 1 0;
    }
  }

  .jewellery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(103, 49, 71, 0.12);
  }

  .jewellery-card__image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #fdfbf7;
  }

  .jewellery-card__image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .jewellery-card:hover .jewellery-card__image-box img {
    transform: scale(1.08);
  }

  .jewellery-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(103, 49, 71, 0.9);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .jewellery-card__body {
    padding: 1.4rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
    justify-content: space-between;
  }

  .jewellery-card__title {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.3;
    color: #103948;
    margin: 0 0 0.4rem;
  }

  .jewellery-card__subtitle {
    font-size: 1.2rem;
    color: #55666f;
    margin: 0 0 1rem;
    line-height: 1.35;
  }

  .jewellery-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: #673147;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .jewellery-card:hover .jewellery-card__cta {
    color: #923e61;
    transform: translateX(3px);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- assign is_de = false -%}
    {%- if request.locale.iso_code == 'de' -%}
      {%- assign is_de = true -%}
    {%- endif -%}

    {%- assign jewel_title = section.settings.title -%}
    {%- assign jewel_subtitle = section.settings.subtitle -%}
    {%- if is_de -%}
      {%- assign jewel_title = 'Indischer Schmuck & Accessoires' -%}
      {%- assign jewel_subtitle = 'Entdecken Sie handgefertigte Brautsets, edle Armreifen, florale Gajras & funkelnden Schmuck' -%}
    {%- endif -%}

    {%- if jewel_title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin center">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ jewel_title }}
        </h2>
        {%- if jewel_subtitle != blank -%}
          <p class="collection__description">
            {{ jewel_subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="jewellery-slider-wrapper">
      <div class="jewellery-slider-track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_title = block.settings.title
            assign card_subtitle = block.settings.subtitle
            assign card_badge = block.settings.badge

            if is_de
              case card_title
                when 'Traditional & Temple Sets'
                  assign card_title = 'Traditioneller & Tempelschmuck'
                  assign card_subtitle = 'Kundan-, Tempel- & Choker-Sets'
                when 'Bangles & Choodas'
                  assign card_title = 'Armreifen & Choodas'
                  assign card_subtitle = 'Kangan, Glas- & Brautarmreifen'
                when 'Hair Gajras & Flowers'
                  assign card_title = 'Gajras & Haarschmuck'
                  assign card_subtitle = 'Florale Haaraccessoires für Feste'
                when 'Modern & AD Jewellery'
                  assign card_title = 'Moderner & AD Schmuck'
                  assign card_subtitle = 'Zirkonia-Choker & Ohrringe'
                when 'Festive Accents'
                  assign card_title = 'Festliche Akzente'
                  assign card_subtitle = 'Kamarbandh & Maang Tikka'
              endcase

              case card_badge
                when 'Heritage & Bridal'
                  assign card_badge = 'Braut & Tradition'
                when 'Classic Styles'
                  assign card_badge = 'Klassiker'
                when 'Hair Accents'
                  assign card_badge = 'Haarschmuck'
                when 'Everyday & Party'
                  assign card_badge = 'Party & Alltag'
                when 'Statement Pieces'
                  assign card_badge = 'Statement'
              endcase
            endif
          -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="jewellery-card"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <div class="jewellery-card__image-box">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', alt: card_title
                }}
              {%- elsif block.settings.asset_image != blank -%}
                <img
                  src="{{ block.settings.asset_image | asset_url }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="500"
                  height="500"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}<img src="{{ 'jewel-traditional.jpg' | asset_url }}" alt="Traditional Jewellery" loading="lazy">
                  {%- when 2 -%}<img src="{{ 'jewel-bangles.jpg' | asset_url }}" alt="Bangles" loading="lazy">
                  {%- when 3 -%}<img src="{{ 'jewel-gajra.jpg' | asset_url }}" alt="Gajras" loading="lazy">
                  {%- when 4 -%}<img src="{{ 'jewel-modern.jpg' | asset_url }}" alt="Modern Jewellery" loading="lazy">
                  {%- when 5 -%}<img src="{{ 'jewel-festive.jpg' | asset_url }}" alt="Festive Jewellery" loading="lazy">
                {%- endcase -%}
              {%- endif -%}

              {%- if card_badge != blank -%}
                <span class="jewellery-card__badge">{{ card_badge }}</span>
              {%- endif -%}
            </div>

            <div class="jewellery-card__body">
              <div>
                <h3 class="jewellery-card__title">{{ card_title }}</h3>
                {%- if card_subtitle != blank -%}
                  <p class="jewellery-card__subtitle">{{ card_subtitle }}</p>
                {%- endif -%}
              </div>
              <span class="jewellery-card__cta">
                {% if is_de %}Kollektion ansehen &rarr;{% else %}View Collection &rarr;{% endif %}
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Jewellery Showcase Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Jewellery & Accessories Collection"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Discover handcrafted bridal sets, exquisite bangles, floral hair gajras & festive accents"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Jewellery Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Asset Image Filename (Optional)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Jewellery Collection"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Explore handcrafted pieces"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Jewellery Showcase Slider",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Traditional Jewellery",
            "badge": "Heritage & Bridal",
            "subtitle": "Kundan, temple & choker sets",
            "asset_image": "jewel-traditional.jpg",
            "link": "/collections/indian-jewellery-in-germany"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Exquisite Bangles",
            "badge": "Bridal & Festive",
            "subtitle": "Choodas, velvet & glass bangles",
            "asset_image": "jewel-bangles.jpg",
            "link": "/collections/exquisit-bangles-by-neha-couture"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Gajras & Hair Accessories",
            "badge": "Floral Elegance",
            "subtitle": "Traditional fragrant hair scrunchies",
            "asset_image": "jewel-gajra.jpg",
            "link": "/collections/indian-gajra-in-germany"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Modern Jewellery",
            "badge": "Contemporary",
            "subtitle": "Chic earrings & statement pieces",
            "asset_image": "jewel-modern.jpg",
            "link": "/collections/jewellery"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Festive Silver Jhumkas",
            "badge": "Navratri & Festive",
            "subtitle": "Oxidised silver & ethnic earrings",
            "asset_image": "jewel-festive.jpg",
            "link": "/collections/navratri-jewellery"
          }
        }
      ]
    }
  ]
}
{% endschema %}
