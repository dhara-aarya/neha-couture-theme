{%- liquid
  assign raw_title = page_title | default: shop.name
  if request.page_type == 'product' and product
    capture raw_title
      render 'clean-title', title: product.title
    endcapture
    assign raw_title = raw_title | strip
  elsif request.page_type == 'collection' and collection
    capture raw_title
      render 'clean-title', title: collection.title
    endcapture
    assign raw_title = raw_title | strip
  endif
  assign og_title = raw_title | replace: '&amp;amp;', '&' | replace: '&amp;amp;', '&' | replace: '&amp;', '&' | replace: '&ndash;', '–' | strip_html | strip

  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign raw_desc = page_description
  if raw_desc == blank and request.page_type == 'collection' and collection
    assign raw_desc = collection.description
  elsif raw_desc == blank and request.page_type == 'product' and product
    assign raw_desc = product.description
  endif
  assign raw_desc = raw_desc | default: shop.description | default: shop.name
  assign og_description = raw_desc | strip_html | replace: '&amp;amp;', '&' | replace: '&amp;amp;', '&' | replace: '&amp;', '&' | replace: '&ndash;', '–' | replace: '&mdash;', '—' | replace: '&quot;', '"' | replace: '&#39;', "'" | strip

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if request.locale.iso_code == 'de'
    if request.page_type == 'index'
      assign og_title = 'Neha Couture – Exquisite indische Couture & Brautmode in Berlin'
      assign og_description = 'Exklusive indische Couture & Brautmode bei Neha Couture Berlin. Handgefertigte Lehengas, Seidensaris, Shararas & Schmuck mit Expressversand in Deutschland & Europa.'
    elsif request.page_type == 'product' and product
      assign og_title = raw_title | append: ' – Indische Mode | Neha Couture Berlin'
      assign og_description = 'Kaufen Sie ' | append: raw_title | append: ' online bei Neha Couture. Schnelle 1–3 Tage DHL-Lieferung in ganz Deutschland & Europa.'
    elsif request.page_type == 'collection' and collection
      assign og_title = raw_title | append: ' – Indische Mode | Neha Couture Berlin'
      assign og_description = 'Entdecken Sie ' | append: raw_title | append: ' bei Neha Couture. Authentische indische Mode & Accessoires in Deutschland mit 1–3 Tage DHL-Lieferung.'
    endif
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape | replace: '&amp;amp;', '&amp;' }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape | replace: '&amp;amp;', '&amp;' }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta name="twitter:image" content="https:{{ page_image | image_url }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="og:availability" content="{% if product.available %}instock{% else %}outofstock{% endif %}">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
  <meta property="product:brand" content="Neha Couture">
  <meta property="product:retailer_item_id" content="{{ product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape | replace: '&amp;amp;', '&amp;' }}">
<meta name="twitter:description" content="{{ og_description | escape | replace: '&amp;amp;', '&amp;' }}">
