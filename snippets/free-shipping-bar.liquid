{%- comment -%}
  Smart Free Shipping Progress Bar
  Accurately calculates thresholds for Neha Couture (€100) and displays Collective info for partner items
{%- endcomment -%}
{%- liquid
  assign neha_threshold = 10000
  assign neha_reduced_threshold = 4000

  assign neha_subtotal = 0
  assign namma_subtotal = 0

  for item in cart.items
    assign v_low = item.product.vendor | downcase
    if v_low contains 'namma'
      assign namma_subtotal = namma_subtotal | plus: item.final_line_price
    else
      assign neha_subtotal = neha_subtotal | plus: item.final_line_price
    endif
  endfor
-%}

{%- if neha_subtotal > 0 -%}
  {%- liquid
    assign amount_left = neha_threshold | minus: neha_subtotal
    assign percent = neha_subtotal | times: 100 | divided_by: neha_threshold
    if percent > 100
      assign percent = 100
    endif
  -%}
  <div class="free-shipping-progress" id="FreeShippingProgress">
    <div class="free-shipping-progress__text">
      {%- if neha_subtotal >= neha_threshold -%}
        <span>🎉 <strong>Glückwunsch!</strong> Kostenloser Versand für <strong>Neha Couture</strong> (Berlin) freigeschaltet!</span>
      {%- elsif neha_subtotal >= neha_reduced_threshold -%}
        {%- assign formatted_left = amount_left | money -%}
        <span>✨ <strong>Toll!</strong> Standardversand auf <strong>1,00 €</strong> reduziert! Noch <strong>{{ formatted_left }}</strong> bis zum <strong>kostenlosen Versand</strong>!</span>
      {%- else -%}
        {%- assign formatted_left = amount_left | money -%}
        <span>Noch <strong>{{ formatted_left }}</strong> Neha Couture Kollektion bis zum <strong>kostenlosen Versand</strong> (ab 100 €)!</span>
      {%- endif -%}
    </div>
    <div class="free-shipping-progress__bar">
      <div class="free-shipping-progress__fill" style="width: {{ percent }}%;"></div>
    </div>
  </div>
{%- elsif namma_subtotal > 0 -%}
  <div class="free-shipping-progress free-shipping-progress--namma" id="FreeShippingProgress">
    <div class="free-shipping-progress__text">
      <span>🚚 <strong>Namma Markt Artikel:</strong> Werden direkt versandt. Versandtarife werden live über Shopify Collective an der Kasse berechnet.</span>
    </div>
  </div>
{%- endif -%}

<style>
  .free-shipping-progress {
    background: #fdf8f4;
    border: 1px solid #ebd9c8;
    border-radius: 8px;
    padding: 1.2rem 1.6rem;
    margin: 0.5rem 1.5rem 1rem;
    text-align: center;
  }
  .free-shipping-progress--namma {
    background: #f0f7fd;
    border-color: #cbe1f5;
  }
  .free-shipping-progress__text {
    font-size: 1.25rem;
    color: #103948;
    margin-bottom: 0.8rem;
    line-height: 1.4;
  }
  .free-shipping-progress--namma .free-shipping-progress__text {
    margin-bottom: 0;
  }
  .free-shipping-progress__text strong {
    color: #673147;
  }
  .free-shipping-progress--namma .free-shipping-progress__text strong {
    color: #12538a;
  }
  .free-shipping-progress__bar {
    width: 100%;
    height: 8px;
    background: #e2d3c5;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .free-shipping-progress__fill {
    height: 100%;
    background: linear-gradient(90deg, #673147 0%, #a84766 100%);
    border-radius: 4px;
    transition: width 0.4s ease;
  }
</style>