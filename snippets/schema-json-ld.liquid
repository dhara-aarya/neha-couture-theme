  {%- for gtoken in geo_tokens -%}
    {%- assign schema_product_title = schema_product_title | replace: gtoken, '' -%}
  {%- endfor -%}
  {%- assign schema_product_title = schema_product_title | strip -%}
{%- endif -%}

{%- comment -%} Dynamically construct non-empty sameAs social profile array {%- endcomment -%}
{%- assign same_as_links = '' -%}
{%- assign maps_link = 'https://www.google.com/maps/search/?api=1&query=Neha+Couture+The+Playce+Berlin' -%}
{%- assign same_as_links = same_as_links | append: maps_link -%}

{%- assign fb_link = settings.social_facebook_link | default: 'https://www.facebook.com/p/Indian-Clothes-Jewellery-in-Germany-100083136706974/' | split: '?' | first | strip -%}
{%- if fb_link != blank -%}
  {%- assign same_as_links = same_as_links | append: '||' | append: fb_link -%}
{%- endif -%}

{%- assign insta_link = settings.social_instagram_link | default: 'https://www.instagram.com/neha_21.2008' | split: '?' | first | strip -%}
{%- if insta_link != blank -%}
  {%- assign same_as_links = same_as_links | append: '||' | append: insta_link -%}
{%- endif -%}

{%- assign pinterest_link = settings.social_pinterest_link | default: 'https://www.pinterest.com/nehacouture/' | split: '?' | first | strip -%}
{%- if pinterest_link != blank -%}
  {%- assign same_as_links = same_as_links | append: '||' | append: pinterest_link -%}
{%- endif -%}

{%- if settings.social_youtube_link != blank -%}
  {%- assign yt_link = settings.social_youtube_link | split: '?' | first | strip -%}
  {%- assign same_as_links = same_as_links | append: '||' | append: yt_link -%}
